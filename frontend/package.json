{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx --yes expo-doctor",
    "eas:config": "npx --yes eas-cli config --platform ios --profile preview --non-interactive",
    "build:ios:preview": "npx --yes eas-cli build --platform ios --profile preview",
    "submit:ios:latest": "npx --yes eas-cli submit --platform ios --latest"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.1.10",
    "axios": "^1.16.1",
    "expo": "~54.0.35",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.17.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
